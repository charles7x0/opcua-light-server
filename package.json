{
  "name": "opcua-light-server",
  "version": "0.1.0",
  "description": "Lightweight OPC UA server with Node.js control API, open62541 runtime, and React web UI",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:web": "npm run build --prefix web",
    "dev": "tsx watch --env-file=.env src/api/server.ts",
    "start": "node --env-file=.env dist/api/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "stress:clients": "tsx tests/stress/stress-clients.ts",
    "stress:variables": "tsx tests/stress/stress-variables.ts",
    "stress:churn": "tsx tests/stress/stress-churn.ts",
    "stress:combined": "tsx tests/stress/stress-combined.ts",
    "stress:benchmark": "tsx tests/stress/benchmark.ts",
    "reset": "node scripts/reset-data.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "ethernet-ip": "^2.0.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "modbus-serial": "^8.0.25",
    "node-forge": "^1.4.0",
    "nodepccc": "^0.1.17",
    "nodes7": "^0.3.16",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fast-check": "^3.23.0",
    "jsdom": "^29.1.1",
    "node-opcua-client": "^2.173.1",
    "pidusage": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
