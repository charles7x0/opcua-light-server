# ─── Control API ────────────────────────────────────────────────────────────
# Port the Express Control API listens on.
PORT=3100

# ─── OPC UA Runtime ────────────────────────────────────────────────────────
# Port the open62541 OPC UA runtime listens on (for client connections).
OPCUA_PORT=4840

# Path to the compiled open62541 runtime binary.
RUNTIME_PATH=runtime/opcua-runtime

# Path to the generated JSON config file consumed by the runtime.
CONFIG_PATH=runtime/config.json

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite database file path.
DB_PATH=runtime/opcua-light.db

# ─── Authentication ────────────────────────────────────────────────────────
# Auth mode: 'none' | 'api-key' | 'jwt'
AUTH_MODE=none

# Comma-separated list of valid API keys (required when AUTH_MODE=api-key).
# API_KEYS=key1,key2,key3

# JWT verification secret (required when AUTH_MODE=jwt).
# JWT_SECRET=your-secret-here

# Optional expected JWT issuer for token validation.
# JWT_ISSUER=your-issuer
