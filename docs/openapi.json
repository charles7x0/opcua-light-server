{
  "openapi": "3.0.3",
  "info": {
    "title": "OPC UA Light Server - Control API",
    "description": "REST API for managing the OPC UA Light Server: address space, server lifecycle, security, multi-protocol PLC connections, and certificate trust.",
    "version": "0.2.0",
    "license": { "name": "MIT" }
  },
  "servers": [
    { "url": "http://localhost:3100", "description": "Local development" }
  ],
  "tags": [
    { "name": "Server", "description": "OPC UA runtime lifecycle" },
    { "name": "Nodes", "description": "OPC UA variable nodes CRUD" },
    { "name": "Namespaces", "description": "Namespace management" },
    { "name": "Object Nodes", "description": "Object node hierarchy" },
    { "name": "Security", "description": "Security mode and certificates" },
    { "name": "Connectors", "description": "Multi-protocol PLC connections, mappings, and live values" },
    { "name": "PKI", "description": "Client certificate trust management (TOFU)" },
    { "name": "Files", "description": "Server-side file browser" },
    { "name": "Events", "description": "Real-time Server-Sent Events stream" },
    { "name": "Logs", "description": "System log entries" }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "enum": ["VALIDATION_ERROR","DUPLICATE_ERROR","NOT_FOUND","UNAUTHORIZED","INTERNAL_ERROR","SERVICE_UNAVAILABLE","RUNTIME_ERROR","CERTIFICATE_NOT_FOUND","ACCESS_DENIED","CONFLICT"] },
              "message": { "type": "string" },
              "details": { "type": "array", "items": { "$ref": "#/components/schemas/ErrorDetail" } }
            }
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "OpcUaDataType": {
        "type": "string",
        "enum": ["Boolean","Int16","Int32","Int64","UInt16","UInt32","UInt64","Float","Double","String","DateTime","ByteString"]
      },
      "OpcUaNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "namespaceId": { "type": "string", "format": "uuid" },
          "objectNodeId": { "type": "string", "format": "uuid", "nullable": true },
          "name": { "type": "string" },
          "dataType": { "$ref": "#/components/schemas/OpcUaDataType" },
          "initialValue": {},
          "description": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateNodeRequest": {
        "type": "object",
        "required": ["name", "namespaceId", "dataType"],
        "properties": {
          "name": { "type": "string" },
          "namespaceId": { "type": "string", "format": "uuid" },
          "objectNodeId": { "type": "string", "format": "uuid", "nullable": true },
          "dataType": { "$ref": "#/components/schemas/OpcUaDataType" },
          "initialValue": {},
          "description": { "type": "string" }
        }
      },
      "UpdateNodeRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "objectNodeId": { "type": "string", "format": "uuid", "nullable": true },
          "dataType": { "$ref": "#/components/schemas/OpcUaDataType" },
          "initialValue": {},
          "description": { "type": "string" }
        }
      },
      "Namespace": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "uri": { "type": "string" },
          "nodeCount": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateNamespaceRequest": {
        "type": "object",
        "required": ["name", "uri"],
        "properties": {
          "name": { "type": "string" },
          "uri": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "ObjectNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "namespaceId": { "type": "string", "format": "uuid" },
          "parentObjectNodeId": { "type": "string", "format": "uuid", "nullable": true },
          "name": { "type": "string" },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/ObjectNode" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateObjectNodeRequest": {
        "type": "object",
        "required": ["name", "namespaceId"],
        "properties": {
          "name": { "type": "string" },
          "namespaceId": { "type": "string", "format": "uuid" },
          "parentObjectNodeId": { "type": "string", "format": "uuid", "nullable": true }
        }
      },
      "SecurityConfig": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["None", "Sign", "SignAndEncrypt"] },
          "certificatePath": { "type": "string" },
          "certificateValid": { "type": "boolean" },
          "privateKeyConfigured": { "type": "boolean" },
          "certificateExpiresAt": { "type": "string", "format": "date-time" },
          "certificateRemainingDays": { "type": "integer" }
        }
      },
      "UpdateSecurityPolicyRequest": {
        "type": "object",
        "required": ["mode"],
        "properties": {
          "mode": { "type": "string", "enum": ["None", "Sign", "SignAndEncrypt"] }
        }
      },
      "GenerateCertificateRequest": {
        "type": "object",
        "properties": {
          "dnsNames": { "type": "array", "items": { "type": "string" } },
          "ipAddresses": { "type": "array", "items": { "type": "string" } },
          "organization": { "type": "string" },
          "country": { "type": "string", "maxLength": 2 },
          "commonName": { "type": "string" },
          "force": { "type": "boolean" }
        }
      },
      "ServerStatus": {
        "type": "object",
        "properties": {
          "state": { "type": "string", "enum": ["running", "stopped", "error"] },
          "uptime": { "type": "integer", "description": "Seconds since start" },
          "pid": { "type": "integer" },
          "connectedClients": { "type": "integer" },
          "lastError": { "type": "string" },
          "hostname": { "type": "string", "description": "Primary non-loopback IPv4 address" },
          "opcuaPort": { "type": "integer", "description": "OPC UA runtime port", "default": 4840 }
        }
      },
      "StartServerResponse": {
        "type": "object",
        "properties": {
          "pid": { "type": "integer" },
          "startedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ClientSession": {
        "type": "object",
        "properties": {
          "applicationName": { "type": "string" },
          "applicationUri": { "type": "string" },
          "securityPolicyUri": { "type": "string" },
          "clientAddress": { "type": "string" },
          "connectTime": { "type": "string", "format": "date-time" },
          "sessionState": { "type": "string", "enum": ["Created", "Activated", "Closing"] }
        }
      },
      "ParamFieldSchema": {
        "type": "object",
        "required": ["key", "label", "type", "required"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "number", "boolean", "select"] },
          "required": { "type": "boolean" },
          "defaultValue": {},
          "placeholder": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "options": { "type": "array", "items": { "type": "object", "properties": { "value": { "type": "string" }, "label": { "type": "string" } } } },
          "pattern": { "type": "string" },
          "patternMessage": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "ConnectorMetadata": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "displayName": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "version": { "type": "string" },
          "paramsSchema": { "type": "array", "items": { "$ref": "#/components/schemas/ParamFieldSchema" } }
        }
      },
      "ConnectorConnection": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "description": "Protocol type (s7, modbus-tcp, ethernet-ip, pccc)" },
          "name": { "type": "string" },
          "params": { "type": "object", "additionalProperties": true },
          "pollingIntervalMs": { "type": "integer" },
          "reconnectIntervalMs": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateConnectionRequest": {
        "type": "object",
        "required": ["type", "name", "params"],
        "properties": {
          "type": { "type": "string" },
          "name": { "type": "string" },
          "params": { "type": "object", "additionalProperties": true },
          "pollingIntervalMs": { "type": "integer", "default": 1000 },
          "reconnectIntervalMs": { "type": "integer", "default": 5000 },
          "enabled": { "type": "boolean", "default": true }
        }
      },
      "ConnectorMapping": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "connectionId": { "type": "string", "format": "uuid" },
          "nodeId": { "type": "string", "format": "uuid", "nullable": true },
          "deviceAddress": { "type": "string" },
          "description": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateMappingRequest": {
        "type": "object",
        "required": ["connectionId", "deviceAddress"],
        "properties": {
          "connectionId": { "type": "string", "format": "uuid" },
          "nodeId": { "type": "string", "format": "uuid" },
          "deviceAddress": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "ConnectorStatus": {
        "type": "object",
        "properties": {
          "connectionId": { "type": "string", "format": "uuid" },
          "state": { "type": "string", "enum": ["connected", "disconnected", "error"] },
          "lastPollAt": { "type": "string", "format": "date-time" },
          "errorMessage": { "type": "string" }
        }
      },
      "ConnectorCurrentValue": {
        "type": "object",
        "properties": {
          "nodeId": { "type": "string", "nullable": true },
          "deviceAddress": { "type": "string" },
          "connectionId": { "type": "string", "format": "uuid" },
          "value": {},
          "quality": { "type": "string", "enum": ["good", "bad"] },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "CertificateInfo": {
        "type": "object",
        "properties": {
          "thumbprint": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "status": { "type": "string", "enum": ["trusted", "rejected"] },
          "subject": { "type": "string" },
          "issuer": { "type": "string" },
          "notBefore": { "type": "string", "format": "date-time" },
          "notAfter": { "type": "string", "format": "date-time" },
          "fileSize": { "type": "integer" }
        }
      },
      "LogEntry": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "level": { "type": "string", "enum": ["info", "warn", "error", "debug"] },
          "source": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    { "ApiKeyAuth": [] },
    { "BearerAuth": [] }
  ],
  "paths": {
    "/api/server/status": {
      "get": {
        "tags": ["Server"],
        "summary": "Get server status",
        "description": "Returns the current OPC UA runtime status including hostname and OPC UA port. Unauthenticated.",
        "security": [],
        "responses": { "200": { "description": "Server status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServerStatus" } } } } }
      }
    },
    "/api/server/clients": {
      "get": {
        "tags": ["Server"],
        "summary": "Get connected client sessions",
        "description": "Returns per-client session details. Unauthenticated.",
        "security": [],
        "responses": { "200": { "description": "Client sessions", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ClientSession" } } } } } }
      }
    },
    "/api/server/start": {
      "post": {
        "tags": ["Server"],
        "summary": "Start the OPC UA runtime",
        "responses": { "200": { "description": "Runtime started", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartServerResponse" } } } }, "409": { "description": "Already running" } }
      }
    },
    "/api/server/stop": {
      "post": {
        "tags": ["Server"],
        "summary": "Stop the OPC UA runtime",
        "responses": { "200": { "description": "Runtime stopped" }, "409": { "description": "Not running" } }
      }
    },
    "/api/server/reload": {
      "post": {
        "tags": ["Server"],
        "summary": "Reload the runtime configuration",
        "responses": { "200": { "description": "Config reloaded" }, "409": { "description": "Not running" } }
      }
    },
    "/api/nodes": {
      "get": {
        "tags": ["Nodes"],
        "summary": "List all nodes",
        "security": [],
        "parameters": [{ "name": "namespaceId", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Node list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OpcUaNode" } } } } } }
      },
      "post": {
        "tags": ["Nodes"],
        "summary": "Create a node",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateNodeRequest" } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpcUaNode" } } } }, "400": { "description": "Validation error" }, "409": { "description": "Duplicate" } }
      }
    },
    "/api/nodes/{id}": {
      "get": {
        "tags": ["Nodes"],
        "summary": "Get node by ID",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Node found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpcUaNode" } } } }, "404": { "description": "Not found" } }
      },
      "put": {
        "tags": ["Nodes"],
        "summary": "Update a node",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateNodeRequest" } } } },
        "responses": { "200": { "description": "Updated" }, "400": { "description": "Validation error" }, "404": { "description": "Not found" }, "409": { "description": "Duplicate" } }
      },
      "delete": {
        "tags": ["Nodes"],
        "summary": "Delete a node",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } }
      }
    },
    "/api/nodes/export/csv": {
      "get": { "tags": ["Nodes"], "summary": "Export nodes as CSV", "security": [], "responses": { "200": { "description": "CSV file", "content": { "text/csv": {} } } } }
    },
    "/api/nodes/import/csv": {
      "post": { "tags": ["Nodes"], "summary": "Import nodes from CSV", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["csv"], "properties": { "csv": { "type": "string" } } } } } }, "responses": { "201": { "description": "All imported" }, "207": { "description": "Partial success" } } }
    },
    "/api/namespaces": {
      "get": { "tags": ["Namespaces"], "summary": "List namespaces", "security": [], "responses": { "200": { "description": "Namespace list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Namespace" } } } } } } },
      "post": { "tags": ["Namespaces"], "summary": "Create a namespace", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateNamespaceRequest" } } } }, "responses": { "201": { "description": "Created" }, "400": { "description": "Validation error" }, "409": { "description": "Duplicate" } } }
    },
    "/api/namespaces/{id}": {
      "put": { "tags": ["Namespaces"], "summary": "Update a namespace", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateNamespaceRequest" } } } }, "responses": { "200": { "description": "Updated" }, "404": { "description": "Not found" } } },
      "delete": { "tags": ["Namespaces"], "summary": "Delete namespace (cascades)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } } }
    },
    "/api/object-nodes": {
      "post": { "tags": ["Object Nodes"], "summary": "Create an object node", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateObjectNodeRequest" } } } }, "responses": { "201": { "description": "Created" }, "400": { "description": "Validation error" }, "409": { "description": "Duplicate" } } }
    },
    "/api/object-nodes/{id}": {
      "delete": { "tags": ["Object Nodes"], "summary": "Delete an object node", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } } }
    },
    "/api/security": {
      "get": { "tags": ["Security"], "summary": "Get security configuration", "security": [], "responses": { "200": { "description": "Security config", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SecurityConfig" } } } } } }
    },
    "/api/security/policy": {
      "put": { "tags": ["Security"], "summary": "Update security mode", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSecurityPolicyRequest" } } } }, "responses": { "200": { "description": "Updated" }, "400": { "description": "Invalid mode" } } }
    },
    "/api/security/certificate": {
      "post": { "tags": ["Security"], "summary": "Upload certificate paths", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["certificatePath", "privateKeyPath"], "properties": { "certificatePath": { "type": "string" }, "privateKeyPath": { "type": "string" } } } } } }, "responses": { "200": { "description": "Paths stored" }, "400": { "description": "Invalid format" } } }
    },
    "/api/security/generate": {
      "post": { "tags": ["Security"], "summary": "Generate self-signed certificate", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateCertificateRequest" } } } }, "responses": { "201": { "description": "Generated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SecurityConfig" } } } }, "400": { "description": "Already exists" } } }
    },
    "/api/security/certificate/download": {
      "get": { "tags": ["Security"], "summary": "Download server certificate", "security": [], "parameters": [{ "name": "format", "in": "query", "schema": { "type": "string", "enum": ["der", "pem"], "default": "der" } }], "responses": { "200": { "description": "Certificate file" }, "404": { "description": "No certificate" } } }
    },
    "/api/connectors/protocols": {
      "get": {
        "tags": ["Connectors"],
        "summary": "List available protocol plugins",
        "description": "Returns metadata and parameter schemas for all discovered connector plugins. Unauthenticated.",
        "security": [],
        "responses": { "200": { "description": "Protocol metadata array", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ConnectorMetadata" } } } } } }
      }
    },
    "/api/connectors/connections": {
      "get": {
        "tags": ["Connectors"],
        "summary": "List connections",
        "security": [],
        "parameters": [{ "name": "type", "in": "query", "schema": { "type": "string" }, "description": "Filter by protocol type" }],
        "responses": { "200": { "description": "Connection list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ConnectorConnection" } } } } } }
      },
      "post": {
        "tags": ["Connectors"],
        "summary": "Create a connection",
        "description": "Creates a connection for any protocol type. Params are validated against the protocol's paramsSchema if available.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateConnectionRequest" } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConnectorConnection" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "409": { "description": "Duplicate" } }
      }
    },
    "/api/connectors/connections/{id}": {
      "put": {
        "tags": ["Connectors"],
        "summary": "Update a connection",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": {"type":"string"}, "params": {"type":"object"}, "pollingIntervalMs": {"type":"integer"}, "reconnectIntervalMs": {"type":"integer"}, "enabled": {"type":"boolean"} } } } } },
        "responses": { "200": { "description": "Updated" }, "400": { "description": "Validation error" }, "404": { "description": "Not found" } }
      },
      "delete": {
        "tags": ["Connectors"],
        "summary": "Delete a connection (cascades mappings)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } }
      }
    },
    "/api/connectors/mappings": {
      "get": {
        "tags": ["Connectors"],
        "summary": "List mappings",
        "security": [],
        "parameters": [{ "name": "connectionId", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Mapping list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ConnectorMapping" } } } } } }
      },
      "post": {
        "tags": ["Connectors"],
        "summary": "Create a mapping",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateMappingRequest" } } } },
        "responses": { "201": { "description": "Created" }, "400": { "description": "Validation error" }, "404": { "description": "Connection not found" }, "409": { "description": "Duplicate" } }
      }
    },
    "/api/connectors/mappings/{id}": {
      "put": {
        "tags": ["Connectors"],
        "summary": "Update a mapping",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
